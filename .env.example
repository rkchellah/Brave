# Brave — environment template.
# Copy to .env in the project root and fill in. .env is gitignored; this file is not,
# so it must never contain a real key.
#
#   Copy-Item .env.example .env
#
# config.py loads .env at import time. A real environment variable of the same name
# always wins over the file.

# ── API keys ──────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
FINNHUB_API_KEY=

# ── Firebase ──────────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/
FIREBASE_CREDENTIALS=serviceAccountKey.json
USER_ID=

# ── Broker ────────────────────────────────────────────────────────────
# Login and server are safe to keep here — they are only the defaults offered
# at the startup prompt.
MT5_LOGIN=
MT5_SERVER=
#
# Do NOT put MT5_PASSWORD here. The bot prompts for it (hidden) at every start
# and never writes it to disk. Set it only for an unattended run with no
# terminal — and then prefer a real environment variable over this file.

# ── Trading (optional overrides — see config.py for defaults) ──────────
# EXECUTION_MODE=MANUAL
# SYMBOLS=EURUSD,XAUUSD,USDJPY,GBPUSD,USDCAD,EURCHF
# RISK_PER_TRADE_PCT=0.01
# DAILY_LOSS_LIMIT_PCT=0.05
